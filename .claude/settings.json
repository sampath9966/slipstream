{
  "plugins": [
    {
      "type": "github",
      "repo": "sampath9966/splitstream",
      "ref": "main"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PLUGIN_ROOT/../bin/slipstream\" install 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
