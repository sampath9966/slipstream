# ---------------------------------------------------------------------------
# Config / paths
# ---------------------------------------------------------------------------

def db_path() -> Path:
    env = os.environ.get("SLIPSTREAM_DB")
    if env:
        return Path(env)
    xdg = os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
    return Path(xdg) / "slipstream" / "ledger.db"


def data_dir() -> Path:
    return db_path().parent


def get_config() -> dict:
    defaults = {
        "warn_threshold_pct": 70,
        "critical_threshold_pct": 90,
        "window_tokens": 1_000_000,
        "pacing_threshold_pct": 60,
        "pacing_max_delay": 300,
        "modules": {"ledger": True, "queue": True, "anchor": True, "guard": True},
    }
    env_path = os.environ.get("SLIPSTREAM_CONFIG")
    if env_path and Path(env_path).exists():
        try:
            with open(env_path) as f:
                return {**defaults, **json.load(f)}
        except Exception:
            pass
    return defaults


# ---------------------------------------------------------------------------
# DB setup
# ---------------------------------------------------------------------------

def open_db(path: Path) -> sqlite3.Connection:
    path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(path))
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys=ON")
    _migrate(conn)
    return conn


def _migrate(conn: sqlite3.Connection) -> None:
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS schema_version (version INTEGER PRIMARY KEY);

        CREATE TABLE IF NOT EXISTS turns (
            id              INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id      TEXT NOT NULL,
            prompt_id       TEXT,
            project         TEXT,
            model           TEXT,
            ts              REAL NOT NULL,
            input_tokens    INTEGER NOT NULL DEFAULT 0,
            output_tokens   INTEGER NOT NULL DEFAULT 0,
            cache_read_tokens  INTEGER NOT NULL DEFAULT 0,
            cache_write_tokens INTEGER NOT NULL DEFAULT 0
        );

        CREATE TABLE IF NOT EXISTS tool_uses (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id  TEXT NOT NULL,
            prompt_id   TEXT,
            tool_name   TEXT NOT NULL,
            file_paths  TEXT,
            ts          REAL NOT NULL
        );

        CREATE TABLE IF NOT EXISTS jobs (
            id              INTEGER PRIMARY KEY AUTOINCREMENT,
            prompt          TEXT NOT NULL,
            rewritten_prompt TEXT,
            rewrite_notes   TEXT,
            status          TEXT NOT NULL DEFAULT 'pending_review',
            priority        INTEGER NOT NULL DEFAULT 0,
            cwd             TEXT,
            files           TEXT,
            after_job_id    INTEGER,
            created_at      REAL NOT NULL,
            started_at      REAL,
            finished_at     REAL,
            exit_code       INTEGER,
            output_path     TEXT
        );

        CREATE TABLE IF NOT EXISTS snapshots (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id  TEXT NOT NULL,
            ts          REAL NOT NULL,
            files_read  TEXT,
            decisions   TEXT,
            open_threads TEXT,
            goal        TEXT,
            compact_text TEXT
        );

        CREATE TABLE IF NOT EXISTS rule_violations (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id  TEXT,
            rule_name   TEXT NOT NULL,
            tool_name   TEXT,
            tool_input  TEXT,
            reason      TEXT,
            ts          REAL NOT NULL
        );

        CREATE TABLE IF NOT EXISTS session_intents (
            id         INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id TEXT NOT NULL UNIQUE,
            intent     TEXT NOT NULL,
            cwd        TEXT,
            ts         REAL NOT NULL
        );

        CREATE TABLE IF NOT EXISTS decision_log (
            id           INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id   TEXT NOT NULL,
            ts           REAL NOT NULL,
            tool_name    TEXT,
            file_path    TEXT,
            description  TEXT,
            prompt_ctx   TEXT
        );

        CREATE TABLE IF NOT EXISTS alerts (
            id         INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id TEXT NOT NULL,
            ts         REAL NOT NULL,
            kind       TEXT NOT NULL,
            severity   TEXT NOT NULL,
            message    TEXT NOT NULL,
            details    TEXT
        );

        CREATE INDEX IF NOT EXISTS idx_turns_session ON turns(session_id);
        CREATE INDEX IF NOT EXISTS idx_turns_ts ON turns(ts);
        CREATE INDEX IF NOT EXISTS idx_tool_uses_session ON tool_uses(session_id);
        CREATE INDEX IF NOT EXISTS idx_tool_uses_tool ON tool_uses(tool_name);
        CREATE INDEX IF NOT EXISTS idx_jobs_status ON jobs(status);
        CREATE INDEX IF NOT EXISTS idx_snapshots_session ON snapshots(session_id);
        CREATE INDEX IF NOT EXISTS idx_decision_log_file ON decision_log(file_path);
        CREATE INDEX IF NOT EXISTS idx_alerts_session ON alerts(session_id);
    """)
    conn.commit()


# ---------------------------------------------------------------------------
# Transcript parsing
# ---------------------------------------------------------------------------

def parse_transcript(path: str) -> dict:
    """Return token usage from the last assistant turn in a JSONL transcript."""
    p = Path(path)
    if not p.exists():
        return {}

    usage = {}
    model = None
    try:
        with open(p) as f:
            lines = f.readlines()

        for line in reversed(lines):
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue

            if obj.get("role") == "assistant" and "usage" in obj:
                usage = _extract_usage(obj["usage"])
                model = obj.get("model")
                break

            if obj.get("type") == "assistant":
                msg = obj.get("message", {})
                if "usage" in msg:
                    usage = _extract_usage(msg["usage"])
                    model = msg.get("model")
                    break

            if "usage" in obj and isinstance(obj.get("usage"), dict):
                u = obj["usage"]
                if any(k in u for k in ("input_tokens", "output_tokens")):
                    usage = _extract_usage(u)
                    model = obj.get("model")
                    break

    except Exception:
        pass

    if model:
        usage["model"] = model
    return usage


def read_transcript_text(path: str, max_lines: int = 200) -> str:
    """Return the last N lines of a transcript as plain text (for anchor extraction)."""
    p = Path(path)
    if not p.exists():
        return ""
    try:
        with open(p) as f:
            lines = f.readlines()
        result = []
        for line in lines[-max_lines:]:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
                role = obj.get("role") or obj.get("type", "")
                content = obj.get("content") or ""
                if isinstance(content, list):
                    parts = [c.get("text", "") for c in content if isinstance(c, dict)]
                    content = " ".join(parts)
                if content and role in ("assistant", "user"):
                    result.append(f"[{role}] {str(content)[:500]}")
            except Exception:
                pass
        return "\n".join(result)
    except Exception:
        return ""


def _extract_usage(u: dict) -> dict:
    return {
        "input_tokens": int(u.get("input_tokens", 0)),
        "output_tokens": int(u.get("output_tokens", 0)),
        "cache_read_tokens": int(
            u.get("cache_read_input_tokens", u.get("cache_read_tokens", 0))
        ),
        "cache_write_tokens": int(
            u.get("cache_creation_input_tokens", u.get("cache_write_tokens", 0))
        ),
    }


# ---------------------------------------------------------------------------
# Budget helpers
# ---------------------------------------------------------------------------

def current_burn_pct(conn: sqlite3.Connection, config: dict) -> float:
    window = config.get("window_tokens", 1_000_000)
    since = time.time() - 5 * 3600
    row = conn.execute(
        "SELECT SUM(input_tokens+output_tokens+cache_read_tokens+cache_write_tokens) as t FROM turns WHERE ts>=?",
        (since,),
    ).fetchone()
    total = row["t"] or 0
    return total / window * 100 if window > 0 else 0


def pace_delay(pct_burned: float, config: dict) -> float:
    threshold = config.get("pacing_threshold_pct", 60)
    max_delay = config.get("pacing_max_delay", 300)
    if pct_burned < threshold:
        return 0.0
    if threshold >= 100:
        return float(max_delay)
    progress = (pct_burned - threshold) / (100.0 - threshold)
    return min(progress * max_delay, float(max_delay))


# ---------------------------------------------------------------------------
# Module 1 commands — ledger
# ---------------------------------------------------------------------------

def cmd_record(args) -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    session_id = payload.get("session_id", "unknown")
    prompt_id = payload.get("prompt_id")
    transcript_path = payload.get("transcript_path", "")
    cwd = payload.get("cwd", "")

    usage = parse_transcript(transcript_path)
    if not usage:
        return 0

    now = time.time()
    try:
        conn = open_db(db_path())
        conn.execute(
            """INSERT INTO turns
               (session_id, prompt_id, project, model, ts,
                input_tokens, output_tokens, cache_read_tokens, cache_write_tokens)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            (
                session_id, prompt_id, cwd, usage.get("model"), now,
                usage.get("input_tokens", 0), usage.get("output_tokens", 0),
                usage.get("cache_read_tokens", 0), usage.get("cache_write_tokens", 0),
            ),
        )
        conn.commit()

        existing = conn.execute(
            "SELECT id FROM session_intents WHERE session_id=?", (session_id,)
        ).fetchone()
        if not existing:
            intent = _extract_first_user_intent(transcript_path)
            if intent:
                conn.execute(
                    "INSERT OR IGNORE INTO session_intents (session_id, intent, cwd, ts) VALUES (?,?,?,?)",
                    (session_id, intent, cwd, now),
                )
                conn.commit()

        config = get_config()

        spike_msg = _detect_spike(conn, session_id, usage, now, config)
        if spike_msg:
            conn.execute(
                "INSERT INTO alerts (session_id, ts, kind, severity, message, details) VALUES (?,?,?,?,?,?)",
                (session_id, now, "spike", "warn", spike_msg, json.dumps(usage)),
            )
            conn.commit()
            print(f"[slipstream] ⚡ COST SPIKE: {spike_msg}", flush=True)

        loop_msg = _detect_loop(conn, session_id)
        if loop_msg:
            conn.execute(
                "INSERT INTO alerts (session_id, ts, kind, severity, message, details) VALUES (?,?,?,?,?,?)",
                (session_id, now, "loop", "warn", loop_msg, None),
            )
            conn.commit()
            print(f"[slipstream] 🔁 LOOP DETECTED: {loop_msg}", flush=True)

        drift_msg = _detect_drift(conn, session_id, now)
        if drift_msg:
            conn.execute(
                "INSERT INTO alerts (session_id, ts, kind, severity, message, details) VALUES (?,?,?,?,?,?)",
                (session_id, now, "drift", "warn", drift_msg, None),
            )
            conn.commit()
            print(f"[slipstream] 🧭 DRIFT: {drift_msg}", flush=True)

        conn.close()
    except Exception:
        pass
    return 0


def cmd_record_tool(args) -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    session_id = payload.get("session_id", "unknown")
    prompt_id = payload.get("prompt_id")
    tool_name = payload.get("tool_name", "unknown")
    tool_input = payload.get("tool_input", {})
    file_paths = _extract_file_paths(tool_name, tool_input)

    now = time.time()
    try:
        conn = open_db(db_path())
        conn.execute(
            "INSERT INTO tool_uses (session_id, prompt_id, tool_name, file_paths, ts) VALUES (?,?,?,?,?)",
            (session_id, prompt_id, tool_name,
             json.dumps(file_paths) if file_paths else None, now),
        )
        conn.commit()

        for fp in file_paths:
            if tool_name == "Read":
                stale_msg = _check_stale_read(conn, session_id, fp, now)
                if stale_msg:
                    conn.execute(
                        "INSERT INTO alerts (session_id, ts, kind, severity, message, details) VALUES (?,?,?,?,?,?)",
                        (session_id, now, "stale", "warn", stale_msg, fp),
                    )
                    conn.commit()
                    print(f"[slipstream] 📂 STALE READ: {stale_msg}", flush=True)

            if tool_name in ("Write", "Edit", "MultiEdit"):
                desc = f"{tool_name} → {_shorten_path(fp)}"
                ctx = json.dumps(tool_input)[:400]
                conn.execute(
                    "INSERT INTO decision_log (session_id, ts, tool_name, file_path, description, prompt_ctx) VALUES (?,?,?,?,?,?)",
                    (session_id, now, tool_name, fp, desc, ctx),
                )
                conn.commit()

                scope_msg = _check_scope_creep(conn, session_id, fp)
                if scope_msg:
                    conn.execute(
                        "INSERT INTO alerts (session_id, ts, kind, severity, message, details) VALUES (?,?,?,?,?,?)",
                        (session_id, now, "scope_creep", "warn", scope_msg, fp),
                    )
                    conn.commit()
                    print(f"[slipstream] 🔭 SCOPE CREEP: {scope_msg}", flush=True)

        conn.close()
    except Exception:
        pass
    return 0


def _extract_file_paths(tool_name: str, tool_input: dict) -> list:
    paths = []
    for key in ("file_path", "path"):
        if key in tool_input and isinstance(tool_input[key], str):
            paths.append(tool_input[key])
    if "edits" in tool_input and isinstance(tool_input["edits"], list):
        for e in tool_input["edits"]:
            if isinstance(e, dict) and "file_path" in e:
                paths.append(e["file_path"])
    if tool_name == "Glob" and "pattern" in tool_input:
        paths.append(tool_input["pattern"])
    return list(dict.fromkeys(paths))


def cmd_report(args) -> int:
    try:
        conn = open_db(db_path())
    except Exception as e:
        print(f"slipstream: cannot open DB: {e}", file=sys.stderr)
        return 1

    config = get_config()
    window = config.get("window_tokens", 1_000_000)
    session_filter = getattr(args, "session", None)
    days = getattr(args, "days", 7)
    since = time.time() - days * 86400

    where_turns = "WHERE t.ts >= ?"
    params_turns: list = [since]
    if session_filter:
        where_turns += " AND t.session_id = ?"
        params_turns.append(session_filter)

    totals = conn.execute(
        f"""SELECT COUNT(DISTINCT session_id) as sessions,
              SUM(input_tokens) as input, SUM(output_tokens) as output,
              SUM(cache_read_tokens) as cache_read, SUM(cache_write_tokens) as cache_write,
              SUM(input_tokens+output_tokens+cache_read_tokens+cache_write_tokens) as total
            FROM turns t {where_turns}""",
        params_turns,
    ).fetchone()

    where_tools = "WHERE tu.ts >= ?"
    params_tools: list = [since]
    if session_filter:
        where_tools += " AND tu.session_id = ?"
        params_tools.append(session_filter)

    per_tool = conn.execute(
        f"SELECT tool_name, COUNT(*) as calls FROM tool_uses tu {where_tools} GROUP BY tool_name ORDER BY calls DESC",
        params_tools,
    ).fetchall()

    read_tools = ("Read", "Edit", "Write", "MultiEdit")
    placeholders = ",".join("?" * len(read_tools))
    per_file_rows = conn.execute(
        f"""SELECT file_paths, COUNT(*) as reads FROM tool_uses tu
            {where_tools} AND tool_name IN ({placeholders}) AND file_paths IS NOT NULL
            GROUP BY file_paths ORDER BY reads DESC LIMIT 20""",
        params_tools + list(read_tools),
    ).fetchall()

    file_counts: dict = {}
    for row in per_file_rows:
        try:
            paths = json.loads(row["file_paths"])
        except Exception:
            paths = [row["file_paths"]]
        for p in paths:
            file_counts[p] = file_counts.get(p, 0) + row["reads"]
    file_counts_sorted = sorted(file_counts.items(), key=lambda x: -x[1])

    per_session = conn.execute(
        f"""SELECT session_id, project,
              SUM(input_tokens+output_tokens+cache_read_tokens+cache_write_tokens) as total,
              COUNT(*) as turns, MIN(ts) as started, MAX(ts) as last_ts
            FROM turns t {where_turns}
            GROUP BY session_id ORDER BY last_ts DESC LIMIT 10""",
        params_turns,
    ).fetchall()

    conn.close()
    total_tokens = totals["total"] or 0

    if getattr(args, "json", False):
        out = {
            "window_days": days,
            "totals": dict(totals),
            "per_tool": [dict(r) for r in per_tool],
            "per_file": [{"path": p, "reads": c} for p, c in file_counts_sorted],
            "per_session": [dict(r) for r in per_session],
        }
        print(json.dumps(out, indent=2))
        return 0

    bar = "─" * 62
    print(f"\n{'Slipstream Burn Report':^62}")
    print(f"{'last ' + str(days) + ' days · no telemetry · local only':^62}")
    print(bar)
    pct = (total_tokens / window * 100) if window > 0 else 0
    print(f"  Total tokens   : {total_tokens:>12,}  ({pct:.1f}% of {window:,} window)")
    print(f"  Input          : {totals['input'] or 0:>12,}")
    print(f"  Output         : {totals['output'] or 0:>12,}")
    print(f"  Cache read     : {totals['cache_read'] or 0:>12,}")
    print(f"  Cache write    : {totals['cache_write'] or 0:>12,}")
    print(f"  Sessions       : {totals['sessions'] or 0:>12,}")
    print()

    if file_counts_sorted and total_tokens > 0:
        top_n = min(11, len(file_counts_sorted))
        top_reads = sum(c for _, c in file_counts_sorted[:top_n])
        all_reads = sum(c for _, c in file_counts_sorted)
        if all_reads > 0:
            pct_files = top_reads / all_reads * 100
            print(f"  ★  {pct_files:.0f}% of file reads came from re-reading {top_n} files.")
            print()

    print(f"  Tool calls (last {days}d):")
    for row in per_tool[:15]:
        print(f"    {row['tool_name']:<30} {row['calls']:>6} calls")

    print()
    print(f"  Most-read files (last {days}d):")
    for path, cnt in file_counts_sorted[:15]:
        print(f"    {_shorten_path(path):<48} {cnt:>4}×")

    print()
    print(f"  Recent sessions:")
    for row in per_session:
        started = datetime.fromtimestamp(row["started"], tz=timezone.utc).strftime("%m-%d %H:%M")
        print(f"    {started}  {_shorten_path(row['project'] or ''):<30}  {row['total']:>9,} tok  {row['turns']} turns")

    print(bar)
    print()
    return 0


_SUBBLOCK = " ▏▎▍▌▋▊▉█"  # 0..8 eighths for smooth bar rendering

def _bar(pct: float, width: int = 8) -> str:
    """Smooth Unicode progress bar using eighth-block characters."""
    total_eighths = round(min(pct, 100) / 100 * width * 8)
    full, remainder = divmod(total_eighths, 8)
    bar = "█" * full
    if remainder and full < width:
        bar += _SUBBLOCK[remainder]
        full += 1
    bar += "·" * (width - full)
    return bar


def _ansi(text: str, code: str) -> str:
    """Wrap text in ANSI colour code; strip if NO_COLOR or not a tty."""
    if os.environ.get("NO_COLOR") or not sys.stdout.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"


def cmd_statusline(args) -> int:
    try:
        conn = open_db(db_path())
    except Exception:
        print("⚡ ? │ 🎯 ? │ 💾 ?")
        return 0

    config = get_config()
    window = config.get("window_tokens", 1_000_000)
    warn_pct = config.get("warn_threshold_pct", 70)
    crit_pct = config.get("critical_threshold_pct", 90)
    since = time.time() - 5 * 3600

    session_id = os.environ.get("CLAUDE_SESSION_ID", "")
    row = conn.execute(
        """SELECT SUM(input_tokens+output_tokens+cache_read_tokens+cache_write_tokens) as total,
                  SUM(cache_read_tokens) as cache_read,
                  COUNT(*) as turns,
                  MIN(ts) as first_ts
           FROM turns WHERE ts>=?""",
        (since,),
    ).fetchone()
    total = row["total"] or 0
    cache_read = row["cache_read"] or 0
    burn_pct = total / window * 100 if window > 0 else 0

    if burn_pct >= crit_pct:
        burn_color = "31"
    elif burn_pct >= warn_pct:
        burn_color = "33"
    else:
        burn_color = "32"

    burn_bar = _bar(burn_pct)
    burn_str = _ansi(burn_bar, burn_color) + _ansi(f" {burn_pct:.0f}%", burn_color)

    drift_pct = 0.0
    if session_id:
        intent_row = conn.execute(
            "SELECT intent FROM session_intents WHERE session_id=?", (session_id,)
        ).fetchone()
        if intent_row:
            intent = intent_row["intent"]
            keywords = {w.lower() for w in re.split(r'\W+', intent) if len(w) > 3}
            files_in_intent = set(re.findall(r'[\w./]+\.(?:py|ts|js|go|rs|rb|java|c|cpp|h|md|yaml|yml|json|toml)', intent))
            cutoff = time.time() - 1800
            edits = conn.execute(
                "SELECT file_paths FROM tool_uses WHERE session_id=? AND tool_name IN ('Write','Edit','MultiEdit') AND ts>=?",
                (session_id, cutoff),
            ).fetchall()
            if len(edits) >= 3:
                unrelated = 0
                for e in edits:
                    fp = (json.loads(e["file_paths"]) if e["file_paths"] else [])
                    fp_str = " ".join(fp).lower()
                    if not any(k in fp_str for k in keywords) and not any(f in fp_str for f in files_in_intent):
                        unrelated += 1
                drift_pct = unrelated / len(edits) * 100

    if drift_pct >= 60:
        drift_color = "31"
    elif drift_pct >= 40:
        drift_color = "33"
    else:
        drift_color = "32"

    drift_bar = _bar(drift_pct)
    drift_str = _ansi(drift_bar, drift_color) + _ansi(f" {drift_pct:.0f}%", drift_color)

    saved = int(cache_read * 0.90)
    if saved >= 1_000_000:
        saved_str = f"{saved/1_000_000:.1f}M"
    elif saved >= 1_000:
        saved_str = f"{saved/1_000:.1f}k"
    else:
        saved_str = str(saved)

    sep = _ansi(" · ", "2")
    print(f"⚡ {burn_str}{sep}🎯 {drift_str}{sep}↓ {_ansi(saved_str, '36')}")
    conn.close()
    return 0


def cmd_monitor(args) -> int:
    session_id = getattr(args, "session_id", None)
    config = get_config()
    warn = config.get("warn_threshold_pct", 70)
    critical = config.get("critical_threshold_pct", 90)
    window = config.get("window_tokens", 1_000_000)
    warned: set = set()

    signal.signal(signal.SIGTERM, lambda _s, _f: sys.exit(0))

    while True:
        try:
            conn = open_db(db_path())
            since = time.time() - 5 * 3600
            q = "SELECT SUM(input_tokens+output_tokens+cache_read_tokens+cache_write_tokens) as t FROM turns WHERE ts>=?"
            params: list = [since]
            if session_id:
                q += " AND session_id=?"
                params.append(session_id)
            row = conn.execute(q, params).fetchone()
            conn.close()
            total = row["t"] or 0
            pct = total / window * 100 if window > 0 else 0

            if pct >= critical and "critical" not in warned:
                warned.add("critical")
                warned.discard("warn")
                print(f"[slipstream] ⚠️  CRITICAL: {pct:.0f}% of rolling window consumed ({total:,}/{window:,} tokens).", flush=True)
            elif pct >= warn and "warn" not in warned:
                warned.add("warn")
                print(f"[slipstream] ⚡ {pct:.0f}% of rolling window consumed ({total:,}/{window:,} tokens).", flush=True)
            elif pct < warn * 0.9:
                warned.discard("warn")
                warned.discard("critical")
        except Exception:
            pass
        time.sleep(30)


# ---------------------------------------------------------------------------
# Module 2 — queue
# ---------------------------------------------------------------------------

def _haiku_rewrite(prompt: str) -> tuple[str, list]:
    """Call Haiku to rewrite a prompt. Returns (rewritten, [change_notes])."""
    api_key = os.environ.get("ANTHROPIC_API_KEY", "")
    if not api_key:
        return prompt, []

    system = textwrap.dedent("""
        You are a prompt quality gate for an automated Claude Code job queue.
        Given a task prompt, check for: vague scope, unresolved references (e.g. "the auth thing"),
        missing file pins for specific files, absent acceptance criteria.

        Rewrite the prompt to fix any issues. Be minimal — only add what's missing.
        Reply ONLY with valid JSON (no prose):
        {
          "rewritten": "<the improved prompt>",
          "changes": ["pinned src/auth/session.py", "narrowed scope to refresh path", ...]
        }
        If no changes needed, return the original prompt and empty changes array.
    """).strip()

    body = json.dumps({
        "model": "claude-haiku-4-5-20251001",
        "max_tokens": 1024,
        "system": system,
        "messages": [{"role": "user", "content": f"Rewrite this task prompt:\n\n{prompt}"}],
    }).encode()

    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages",
        data=body,
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read())
        text = data["content"][0]["text"].strip()
        result = json.loads(text)
        return result.get("rewritten", prompt), result.get("changes", [])
    except Exception:
        return prompt, []


def cmd_add(args) -> int:
    prompt = args.prompt
    cwd = getattr(args, "cwd", None) or os.getcwd()
    files = getattr(args, "files", None) or []
    after = getattr(args, "after", None)
    priority = getattr(args, "priority", 0)

    print(f"[slipstream] Pre-flight check...", end=" ", flush=True)
    rewritten, changes = _haiku_rewrite(prompt)
    if changes:
        print(f"rewrote prompt ({len(changes)} change(s)).")
    else:
        print("OK.")

    conn = open_db(db_path())
    conn.execute(
        """INSERT INTO jobs (prompt, rewritten_prompt, rewrite_notes, status,
           priority, cwd, files, after_job_id, created_at)
           VALUES (?,?,?,?,?,?,?,?,?)""",
        (
            prompt,
            rewritten if changes else None,
            json.dumps(changes) if changes else None,
            "pending_review" if changes else "approved",
            priority, cwd,
            json.dumps(files) if files else None,
            after,
            time.time(),
        ),
    )
    job_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    conn.commit()
    conn.close()

    status = "pending_review" if changes else "approved"
    print(f"[slipstream] Job #{job_id} enqueued (status: {status}).")
    if changes:
        print(f"  Run 'slipstream approve' to review rewrites before dispatch.")
    return 0


def cmd_approve(args) -> int:
    conn = open_db(db_path())
    pending = conn.execute(
        "SELECT * FROM jobs WHERE status='pending_review' ORDER BY created_at"
    ).fetchall()

    if not pending:
        print("[slipstream] No jobs pending review.")
        conn.close()
        return 0

    print(f"[slipstream] {len(pending)} job(s) pending review.\n")
    approved_ids = []
    rejected_ids = []

    for job in pending:
        changes = json.loads(job["rewrite_notes"] or "[]")
        print(f"Job #{job['id']}")
        print(f"  Original : {job['prompt'][:120]}")
        print(f"  Rewritten: {(job['rewritten_prompt'] or job['prompt'])[:120]}")
        if changes:
            for c in changes:
                print(f"  • {c}")
        print()
        choice = input("  [a]pprove rewrite / [k]eep original / [d]elete job? [a/k/d]: ").strip().lower()
        if choice == "d":
            conn.execute("UPDATE jobs SET status='cancelled' WHERE id=?", (job["id"],))
            rejected_ids.append(job["id"])
            print(f"  → Job #{job['id']} cancelled.")
        elif choice == "k":
            conn.execute(
                "UPDATE jobs SET status='approved', rewritten_prompt=NULL WHERE id=?",
                (job["id"],),
            )
            approved_ids.append(job["id"])
            print(f"  → Job #{job['id']} approved with original prompt.")
        else:
            conn.execute("UPDATE jobs SET status='approved' WHERE id=?", (job["id"],))
            approved_ids.append(job["id"])
            print(f"  → Job #{job['id']} approved with rewritten prompt.")
        print()

    conn.commit()
    conn.close()
    print(f"[slipstream] {len(approved_ids)} approved, {len(rejected_ids)} cancelled.")
    return 0


def cmd_queue_list(args) -> int:
    conn = open_db(db_path())
    status_filter = getattr(args, "status", None)
    q = "SELECT * FROM jobs"
    params: list = []
    if status_filter:
        q += " WHERE status=?"
        params.append(status_filter)
    q += " ORDER BY priority DESC, created_at"
    jobs = conn.execute(q, params).fetchall()
    conn.close()

    if not jobs:
        print("[slipstream] No jobs.")
        return 0

    if getattr(args, "json", False):
        print(json.dumps([dict(j) for j in jobs], indent=2))
        return 0

    print(f"{'ID':>4}  {'STATUS':<16}  {'PRI':>3}  {'PROMPT'}")
    print("─" * 70)
    for j in jobs:
        prompt = (j["rewritten_prompt"] or j["prompt"])[:50]
        print(f"{j['id']:>4}  {j['status']:<16}  {j['priority']:>3}  {prompt}")
    return 0


def cmd_dispatch(args) -> int:
    config = get_config()
    output_dir = data_dir() / "outputs"
    output_dir.mkdir(parents=True, exist_ok=True)

    signal.signal(signal.SIGTERM, lambda _s, _f: sys.exit(0))

    print(f"[slipstream dispatcher] started pid={os.getpid()}", flush=True)

    while True:
        try:
            conn = open_db(db_path())
            pct = current_burn_pct(conn, config)
            delay = pace_delay(pct, config)

            if delay > 0:
                conn.close()
                time.sleep(min(delay, 30))
                continue

            job = conn.execute(
                """SELECT j.* FROM jobs j
                   WHERE j.status='approved'
                     AND (j.after_job_id IS NULL
                          OR EXISTS (SELECT 1 FROM jobs d WHERE d.id=j.after_job_id AND d.status='done'))
                   ORDER BY j.priority DESC, j.created_at
                   LIMIT 1"""
            ).fetchone()

            if not job:
                conn.close()
                time.sleep(10)
                continue

            conn.execute("UPDATE jobs SET status='running', started_at=? WHERE id=?",
                         (time.time(), job["id"]))
            conn.commit()
            conn.close()

            print(f"[slipstream dispatcher] dispatching job #{job['id']} ({pct:.0f}% burn)", flush=True)
            prompt = job["rewritten_prompt"] or job["prompt"]
            output_path = output_dir / f"job-{job['id']}.txt"

            cmd = ["claude", "-p", prompt]
            env = dict(os.environ)
            cwd = job["cwd"] or os.getcwd()

            if job["files"]:
                try:
                    files = json.loads(job["files"])
                    if files:
                        cmd += ["--files"] + files
                except Exception:
                    pass

            try:
                result = subprocess.run(
                    cmd, capture_output=True, text=True, cwd=cwd, env=env, timeout=3600
                )
                exit_code = result.returncode
                with open(output_path, "w") as f:
                    f.write(result.stdout)
                    if result.stderr:
                        f.write("\n--- stderr ---\n")
                        f.write(result.stderr)
            except subprocess.TimeoutExpired:
                exit_code = -1
                output_path.write_text("TIMEOUT after 3600s")
            except FileNotFoundError:
                exit_code = -2
                output_path.write_text("ERROR: 'claude' not found on PATH")

            conn2 = open_db(db_path())
            status = "done" if exit_code == 0 else "failed"
            conn2.execute(
                "UPDATE jobs SET status=?, finished_at=?, exit_code=?, output_path=? WHERE id=?",
                (status, time.time(), exit_code, str(output_path), job["id"]),
            )
            conn2.commit()
            conn2.close()
            print(f"[slipstream dispatcher] job #{job['id']} {status} (exit {exit_code})", flush=True)

        except Exception as e:
            print(f"[slipstream dispatcher] error: {e}", flush=True)
            time.sleep(5)


def cmd_service(args) -> int:
    action = args.action
    engine = str(Path(__file__).resolve())
    dispatch_cmd = f"{engine} dispatch"

    system = platform.system()

    if action == "status":
        if system == "Darwin":
            label = "com.slipstream.dispatch"
            r = subprocess.run(["launchctl", "list", label], capture_output=True, text=True)
            if r.returncode == 0:
                print(f"[slipstream service] running (launchd: {label})")
            else:
                print(f"[slipstream service] not running")
        elif system == "Linux":
            r = subprocess.run(["systemctl", "--user", "is-active", "slipstream-dispatch"],
                                capture_output=True, text=True)
            print(f"[slipstream service] {r.stdout.strip()}")
        else:
            print(f"[slipstream service] unsupported OS: {system}")
        return 0

    if action == "install":
        if system == "Darwin":
            plist_path = Path.home() / "Library" / "LaunchAgents" / "com.slipstream.dispatch.plist"
            plist_path.parent.mkdir(parents=True, exist_ok=True)
            plist_path.write_text(textwrap.dedent(f"""\
                <?xml version="1.0" encoding="UTF-8"?>
                <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
                  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
                <plist version="1.0">
                <dict>
                  <key>Label</key>
                  <string>com.slipstream.dispatch</string>
                  <key>ProgramArguments</key>
                  <array>
                    <string>{sys.executable}</string>
                    <string>{engine}</string>
                    <string>dispatch</string>
                  </array>
                  <key>RunAtLoad</key>
                  <true/>
                  <key>KeepAlive</key>
                  <true/>
                  <key>StandardOutPath</key>
                  <string>{data_dir()}/dispatch.log</string>
                  <key>StandardErrorPath</key>
                  <string>{data_dir()}/dispatch.log</string>
                  <key>EnvironmentVariables</key>
                  <dict>
                    <key>PATH</key>
                    <string>{os.environ.get('PATH', '/usr/local/bin:/usr/bin:/bin')}</string>
                  </dict>
                </dict>
                </plist>
            """))
            subprocess.run(["launchctl", "load", str(plist_path)], check=False)
            print(f"[slipstream service] installed and started (launchd).")
            print(f"  Plist: {plist_path}")
            print(f"  Log:   {data_dir()}/dispatch.log")

        elif system == "Linux":
            unit_dir = Path.home() / ".config" / "systemd" / "user"
            unit_dir.mkdir(parents=True, exist_ok=True)
            unit_path = unit_dir / "slipstream-dispatch.service"
            unit_path.write_text(textwrap.dedent(f"""\
                [Unit]
                Description=Slipstream job dispatcher
                After=default.target

                [Service]
                ExecStart={sys.executable} {engine} dispatch
                Restart=always
                RestartSec=5
                StandardOutput=append:{data_dir()}/dispatch.log
                StandardError=append:{data_dir()}/dispatch.log
                Environment=PATH={os.environ.get('PATH', '/usr/local/bin:/usr/bin:/bin')}

                [Install]
                WantedBy=default.target
            """))
            subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
            subprocess.run(["systemctl", "--user", "enable", "--now", "slipstream-dispatch"], check=False)
            print(f"[slipstream service] installed and started (systemd user).")
            print(f"  Unit: {unit_path}")
            print(f"  Log:  {data_dir()}/dispatch.log")
        else:
            print(f"[slipstream service] unsupported OS: {system}. Run manually: {dispatch_cmd}")
            return 1
        return 0

    if action == "uninstall":
        if system == "Darwin":
            plist_path = Path.home() / "Library" / "LaunchAgents" / "com.slipstream.dispatch.plist"
            subprocess.run(["launchctl", "unload", str(plist_path)], check=False)
            plist_path.unlink(missing_ok=True)
            print("[slipstream service] uninstalled.")
        elif system == "Linux":
            subprocess.run(["systemctl", "--user", "disable", "--now", "slipstream-dispatch"], check=False)
            unit = Path.home() / ".config" / "systemd" / "user" / "slipstream-dispatch.service"
            unit.unlink(missing_ok=True)
            subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
            print("[slipstream service] uninstalled.")
        return 0

    print(f"Unknown service action: {action}")
    return 1


# ---------------------------------------------------------------------------
# Module 3 — compaction anchor
# ---------------------------------------------------------------------------

def _extract_decisions(text: str) -> str:
    patterns = [
        r"(?i)(decided|will use|using|schema:|api:|we('ll| will)|going with|approach:)[^\n]{10,120}",
        r"(?i)(don't|do not|never|always|must)[^\n]{10,80}",
        r"(?i)(the \w+ (is|will be|should)[^\n]{5,80})",
    ]
    decisions = []
    for pat in patterns:
        for m in re.finditer(pat, text):
            line = m.group(0).strip()
            if line not in decisions:
                decisions.append(line)
            if len(decisions) >= 15:
                break
    return "\n".join(decisions[:15])


def _file_hash(path: str) -> str:
    try:
        h = hashlib.sha256()
        h.update(Path(path).read_bytes()[:4096])
        return h.hexdigest()[:12]
    except Exception:
        return "?"


def cmd_anchor_snapshot(args) -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    session_id = payload.get("session_id", "unknown")
    transcript_path = payload.get("transcript_path", "")
    cwd = payload.get("cwd", "")

    try:
        conn = open_db(db_path())

        since_session = time.time() - 24 * 3600
        rows = conn.execute(
            """SELECT file_paths FROM tool_uses
               WHERE session_id=? AND tool_name IN ('Read','Edit','Write','MultiEdit')
               AND file_paths IS NOT NULL AND ts>=?""",
            (session_id, since_session),
        ).fetchall()

        file_set: dict = {}
        for row in rows:
            try:
                for p in json.loads(row["file_paths"]):
                    if p not in file_set:
                        file_set[p] = _file_hash(p)
            except Exception:
                pass

        files_read = [{"path": p, "hash": h} for p, h in list(file_set.items())[:30]]

        transcript_text = read_transcript_text(transcript_path)
        decisions = _extract_decisions(transcript_text)

        compact_lines = ["=== SLIPSTREAM ANCHOR (preserved across compaction) ==="]
        if cwd:
            compact_lines.append(f"Project: {_shorten_path(cwd)}")
        if files_read:
            compact_lines.append(f"\nFiles read this session ({len(files_read)}):")
            for f in files_read[:20]:
                compact_lines.append(f"  {_shorten_path(f['path'])} [{f['hash']}]")
        if decisions:
            compact_lines.append(f"\nKey decisions/constraints:")
            compact_lines.append(decisions)
        compact_lines.append("=== END ANCHOR ===")
        compact_text = "\n".join(compact_lines)

        conn.execute(
            """INSERT INTO snapshots (session_id, ts, files_read, decisions, compact_text)
               VALUES (?,?,?,?,?)""",
            (session_id, time.time(), json.dumps(files_read), decisions, compact_text),
        )
        conn.commit()
        conn.close()

        print(compact_text)

    except Exception:
        pass
    return 0


def cmd_anchor_inject(args) -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    session_id = payload.get("session_id", "unknown")

    try:
        conn = open_db(db_path())
        row = conn.execute(
            "SELECT compact_text FROM snapshots WHERE session_id=? ORDER BY ts DESC LIMIT 1",
            (session_id,),
        ).fetchone()
        conn.close()

        if row and row["compact_text"]:
            print(row["compact_text"])
    except Exception:
        pass
    return 0


def cmd_anchor(args) -> int:
    session_id = getattr(args, "session_id", None)
    conn = open_db(db_path())

    if not session_id:
        row = conn.execute(
            "SELECT DISTINCT session_id FROM snapshots ORDER BY (SELECT MAX(ts) FROM snapshots s2 WHERE s2.session_id=snapshots.session_id) DESC LIMIT 1"
        ).fetchone()
        if row:
            session_id = row["session_id"]

    if not session_id:
        print("[slipstream anchor] No snapshots found.")
        conn.close()
        return 0

    snaps = conn.execute(
        "SELECT * FROM snapshots WHERE session_id=? ORDER BY ts DESC LIMIT 5",
        (session_id,),
    ).fetchall()
    conn.close()

    if not snaps:
        print(f"[slipstream anchor] No snapshots for session {session_id}.")
        return 0

    snap = snaps[0]
    print(f"\n[slipstream anchor] Latest snapshot for {session_id[:16]}...\n")
    print(snap["compact_text"] or "(empty)")
    print()
    return 0


# ---------------------------------------------------------------------------
# Module 4 — rule guard
# ---------------------------------------------------------------------------

def _load_rules(project_dir: str) -> list:
    rules_path = Path(project_dir) / ".slipstream" / "rules.yaml"
    if not rules_path.exists():
        return []
    try:
        import re as _re
        text = rules_path.read_text()
        rules = []
        current: dict = {}
        for line in text.splitlines():
            line = line.rstrip()
            if line.startswith("  - name:") or line.startswith("- name:"):
                if current:
                    rules.append(current)
                current = {"name": line.split(":", 1)[1].strip().strip("\"'")}
            elif current:
                for key in ("on", "check", "message", "enabled"):
                    if _re.match(rf"\s+{key}:", line):
                        val = line.split(":", 1)[1].strip().strip("\"'")
                        current[key] = val
        if current:
            rules.append(current)
        return [r for r in rules if r.get("enabled", "true").lower() != "false"]
    except Exception:
        return []


def _matches_command(pattern: str, command: str) -> bool:
    pattern = pattern.lower().strip()
    command = command.lower().strip()
    return pattern in command or re.search(re.escape(pattern), command) is not None


def cmd_guard_check(args) -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    tool_name = payload.get("tool_name", "")
    tool_input = payload.get("tool_input", {})
    session_id = payload.get("session_id", "unknown")
    cwd = payload.get("cwd", "") or os.getcwd()

    if tool_name != "Bash":
        return 0

    command = tool_input.get("command", "")
    rules = _load_rules(cwd)
    if not rules:
        return 0

    violations = []
    for rule in rules:
        pattern = rule.get("on", "")
        if not pattern or not _matches_command(pattern, command):
            continue

        check_cmd = rule.get("check", "")
        if not check_cmd:
            continue

        try:
            result = subprocess.run(
                check_cmd, shell=True, capture_output=True, text=True, cwd=cwd, timeout=60
            )
            if result.returncode != 0:
                output = (result.stdout + result.stderr).strip()[:500]
                violations.append({
                    "rule": rule["name"],
                    "message": rule.get("message", f"Rule '{rule['name']}' failed"),
                    "output": output,
                })
        except subprocess.TimeoutExpired:
            violations.append({
                "rule": rule["name"],
                "message": f"Rule '{rule['name']}' timed out",
                "output": "",
            })
        except Exception as e:
            violations.append({
                "rule": rule["name"],
                "message": f"Rule '{rule['name']}' error: {e}",
                "output": "",
            })

    if not violations:
        return 0

    try:
        conn = open_db(db_path())
        for v in violations:
            conn.execute(
                "INSERT INTO rule_violations (session_id, rule_name, tool_name, tool_input, reason, ts) VALUES (?,?,?,?,?,?)",
                (session_id, v["rule"], tool_name, json.dumps(tool_input), v["message"], time.time()),
            )
        conn.commit()
        conn.close()
    except Exception:
        pass

    lines = ["[slipstream guard] Blocked — rule violation(s):\n"]
    for v in violations:
        lines.append(f"✗ {v['message']}")
        if v["output"]:
            lines.append(f"  {v['output'][:300]}")
        lines.append("")
    lines.append("Fix the issue above, then retry the command.")
    print("\n".join(lines))
    return 2


def cmd_guard_init(args) -> int:
    project_dir = args.project_dir or os.getcwd()
    claude_md = Path(project_dir) / "CLAUDE.md"
    rules_dir = Path(project_dir) / ".slipstream"
    rules_path = rules_dir / "rules.yaml"

    if rules_path.exists() and not getattr(args, "force", False):
        print(f"[slipstream guard] {rules_path} already exists. Use --force to overwrite.")
        return 1

    existing_rules = ""
    if claude_md.exists():
        text = claude_md.read_text()
        rule_lines = []
        for line in text.splitlines():
            line = line.strip().lstrip("#- *").strip()
            if len(line) < 10:
                continue
            lower = line.lower()
            if any(kw in lower for kw in ("never", "always", "must", "don't", "do not", "before commit", "tests pass", "no todo", "no secret", "lint")):
                rule_lines.append(f"  # from CLAUDE.md: {line}")
        existing_rules = "\n".join(rule_lines[:10])

    rules_dir.mkdir(parents=True, exist_ok=True)
    rules_path.write_text(textwrap.dedent(f"""\
        # slipstream rule guard — .slipstream/rules.yaml
        # Rules run before matching tool calls. Exit code != 0 blocks the call.
        # Sourced from: {claude_md if claude_md.exists() else 'default template'}
        #
        # Inferred from CLAUDE.md:
        {existing_rules or '  # (no CLAUDE.md found)'}

        rules:
          - name: tests_pass
            on: "git commit"
            check: "python3 -m pytest --tb=short -q 2>&1 | tail -5"
            message: "Tests must pass before committing"
            enabled: "false"

          - name: no_todo_markers
            on: "git commit"
            check: "! git diff --cached | grep -E '^\\\\+.*\\\\b(TODO|FIXME|HACK)\\\\b' | head -5"
            message: "Remove TODO/FIXME/HACK markers before committing"
            enabled: "false"

          - name: no_secrets
            on: "git commit"
            check: "! git diff --cached | grep -iE '^\\\\+.*(password|secret|api_key)\\\\s*=\\\\s*[\\"\\x27][^\\"\\x27]'"
            message: "Possible secret in staged changes — verify before committing"
            enabled: "false"

          - name: lint_clean
            on: "git commit"
            check: "python3 -m flake8 --max-line-length=120 --select=E9,F . 2>&1 | head -10"
            message: "Fix syntax errors before committing"
            enabled: "false"
    """))

    print(f"[slipstream guard] Created {rules_path}")
    print(f"  Edit it and set enabled: 'true' for each rule you want active.")
    return 0


# ---------------------------------------------------------------------------
# Module 5 — Token coach, decision accelerator, warm-up
# ---------------------------------------------------------------------------

_AVG_TOKENS_PER_READ = 520
_CACHE_READ_COST_RATIO = 0.10


def _coach_analysis(conn: sqlite3.Connection, config: dict, days: int = 7) -> dict:
    since = time.time() - days * 86400
    window = config.get("window_tokens", 1_000_000)

    totals = conn.execute(
        "SELECT SUM(input_tokens+output_tokens+cache_read_tokens+cache_write_tokens) as t FROM turns WHERE ts>=?",
        (since,),
    ).fetchone()
    total_tokens = totals["t"] or 0

    rows = conn.execute(
        """SELECT file_paths, COUNT(*) as reads FROM tool_uses
           WHERE tool_name IN ('Read','Edit','Write','MultiEdit')
             AND file_paths IS NOT NULL AND ts>=?
           GROUP BY file_paths ORDER BY reads DESC""",
        (since,),
    ).fetchall()

    file_counts: dict = {}
    for row in rows:
        try:
            for p in json.loads(row["file_paths"]):
                file_counts[p] = file_counts.get(p, 0) + row["reads"]
        except Exception:
            pass

    recs = []
    for path, reads in sorted(file_counts.items(), key=lambda x: -x[1]):
        if reads < 2:
            continue
        wasted = reads - 1
        tokens_wasted = int(wasted * _AVG_TOKENS_PER_READ * (1 - _CACHE_READ_COST_RATIO))
        pct_of_window = tokens_wasted / window * 100 if window > 0 else 0
        recs.append({
            "path": path,
            "reads": reads,
            "wasted_reads": wasted,
            "tokens_wasted": tokens_wasted,
            "pct_of_window": round(pct_of_window, 1),
            "fix": "pin to CLAUDE.md (cache-read on subsequent turns)",
        })

    total_waste = sum(r["tokens_wasted"] for r in recs)
    potential_pct = (total_waste / total_tokens * 100) if total_tokens > 0 else 0

    return {
        "days": days,
        "total_tokens": total_tokens,
        "total_waste_tokens": total_waste,
        "potential_saving_pct": round(potential_pct, 1),
        "recommendations": recs[:20],
    }


def cmd_coach(args) -> int:
    try:
        conn = open_db(db_path())
    except Exception as e:
        print(f"slipstream: cannot open DB: {e}", file=sys.stderr)
        return 1

    config = get_config()
    days = getattr(args, "days", 7)
    analysis = _coach_analysis(conn, config, days)
    conn.close()

    if getattr(args, "json", False):
        print(json.dumps(analysis, indent=2))
        return 0

    bar = "─" * 62
    print(f"\n{'Slipstream Token Coach':^62}")
    print(f"{'last ' + str(days) + ' days · no telemetry · local only':^62}")
    print(bar)
    total = analysis["total_tokens"]
    waste = analysis["total_waste_tokens"]
    pct_save = analysis["potential_saving_pct"]
    print(f"  Total spend    : {total:>12,} tokens")
    print(f"  Recoverable    : {waste:>12,} tokens  ({pct_save:.0f}% savings potential)")
    print()
    print("  ── TOP TOKEN SINKS (re-read waste) ────────────────────────────")
    print()

    recs = analysis["recommendations"]
    if not recs:
        print("  ✓ No significant re-read waste found. Session is efficient.")
    else:
        for i, r in enumerate(recs[:10], 1):
            print(f"  {i:>2}. {_shorten_path(r['path'])}")
            print(f"      {r['reads']}× reads → {r['wasted_reads']} wasted → ~{r['tokens_wasted']:,} tok  ({r['pct_of_window']:.1f}% window)")
            print(f"      Fix: {r['fix']}")
            print()

    if pct_save >= 10:
        print(f"  ► Run `slipstream optimize` to generate CLAUDE.md pins → target -{pct_save:.0f}% usage")
    print(bar)
    print()
    return 0


def cmd_optimize(args) -> int:
    try:
        conn = open_db(db_path())
    except Exception as e:
        print(f"slipstream: cannot open DB: {e}", file=sys.stderr)
        return 1

    config = get_config()
    days = getattr(args, "days", 7)
    top_n = getattr(args, "top", 10)
    analysis = _coach_analysis(conn, config, days)
    conn.close()

    recs = analysis["recommendations"]
    if not recs:
        print("[slipstream optimize] No re-read waste found. Nothing to optimize.")
        return 0

    hot_files = [r["path"] for r in recs[:top_n]]

    project_dir = getattr(args, "project_dir", None) or os.getcwd()
    claude_md = Path(project_dir) / "CLAUDE.md"
    out_path = getattr(args, "output", None)

    block = textwrap.dedent(f"""\
        <!-- slipstream: auto-generated context pins ({datetime.now().strftime('%Y-%m-%d')}) -->
        <!-- These files are read frequently. Listing them here helps Claude cache them. -->
        <!-- Generated by: slipstream optimize --days {days} -->

        ## Frequently-read files (pre-load for context efficiency)

    """)
    for p in hot_files:
        block += f"- `{p}`\n"
    block += "\n<!-- end slipstream pins -->\n"

    if out_path:
        Path(out_path).write_text(block)
        print(f"[slipstream optimize] Written to {out_path}")
    elif claude_md.exists() and not getattr(args, "dry_run", False):
        existing = claude_md.read_text()
        existing = re.sub(
            r"<!-- slipstream: auto-generated context pins.*?<!-- end slipstream pins -->\n",
            "", existing, flags=re.DOTALL
        )
        claude_md.write_text(existing.rstrip() + "\n\n" + block)
        print(f"[slipstream optimize] Updated {claude_md} with {len(hot_files)} pinned files.")
        print(f"  Estimated saving: ~{analysis['potential_saving_pct']:.0f}% token reduction on re-reads")
    else:
        print(block)
        if not out_path:
            print(f"[slipstream optimize] Pipe this into your CLAUDE.md or run with --output FILE")

    return 0


def _haiku_decide(prompt: str, context: str) -> dict:
    api_key = os.environ.get("ANTHROPIC_API_KEY", "")
    if not api_key:
        return {}

    system = textwrap.dedent("""
        You are a senior engineering advisor. Given a task prompt and optional context,
        produce a concise decision brief. Reply ONLY with valid JSON:
        {
          "action": "<one sentence: what will happen>",
          "impact": "<one sentence: user/system impact>",
          "risk": "<one sentence: main risk or 'low'>",
          "recommendation": "approve" | "review" | "reject",
          "reason": "<≤8 words explaining recommendation>"
        }
    """).strip()

    user_msg = f"Task: {prompt}"
    if context:
        user_msg += f"\n\nContext:\n{context[:800]}"

    body = json.dumps({
        "model": "claude-haiku-4-5-20251001",
        "max_tokens": 512,
        "system": system,
        "messages": [{"role": "user", "content": user_msg}],
    }).encode()

    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages",
        data=body,
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read())
        text = data["content"][0]["text"].strip()
        return json.loads(text)
    except Exception:
        return {}


def cmd_decide(args) -> int:
    try:
        conn = open_db(db_path())
    except Exception as e:
        print(f"slipstream: cannot open DB: {e}", file=sys.stderr)
        return 1

    jobs = conn.execute(
        "SELECT * FROM jobs WHERE status IN ('pending_review','approved') ORDER BY priority DESC, created_at LIMIT 10"
    ).fetchall()

    if not jobs:
        print("[slipstream decide] No pending decisions.")
        conn.close()
        return 0

    snap = conn.execute(
        "SELECT decisions FROM snapshots ORDER BY ts DESC LIMIT 1"
    ).fetchone()
    context = snap["decisions"] if snap else ""
    conn.close()

    bar = "─" * 62
    print(f"\n{'Slipstream Decision Brief':^62}")
    print(f"{'powered by Claude Haiku · no data leaves your machine':^62}")
    print(bar)

    for job in jobs:
        prompt = job["rewritten_prompt"] or job["prompt"]
        brief = _haiku_decide(prompt, context)

        rec_sym = {"approve": "✅", "review": "⚠️ ", "reject": "❌"}.get(
            brief.get("recommendation", ""), "·"
        )

        print(f"\n  Job #{job['id']}  [{job['status']}]")
        print(f"  Prompt : {prompt[:90]}")
        if brief:
            print(f"  Action : {brief.get('action', '—')}")
            print(f"  Impact : {brief.get('impact', '—')}")
            print(f"  Risk   : {brief.get('risk', '—')}")
            print(f"  {rec_sym} {brief.get('recommendation', '?').upper()}: {brief.get('reason', '')}")
        else:
            print(f"  (Set ANTHROPIC_API_KEY for Haiku-powered analysis)")

    print(f"\n{bar}")
    print(f"  Run `slipstream approve` to act on the above.\n")
    return 0


def cmd_warmup(args) -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    session_id = payload.get("session_id", "unknown")
    cwd = payload.get("cwd", "") or os.getcwd()

    try:
        conn = open_db(db_path())
        config = get_config()

        analysis = _coach_analysis(conn, config, 14)
        hot_files = [r["path"] for r in analysis["recommendations"][:8]]

        pending = conn.execute(
            "SELECT id, prompt, status, priority FROM jobs WHERE status IN ('pending_review','approved') ORDER BY priority DESC, created_at LIMIT 5"
        ).fetchall()

        recent_alerts = conn.execute(
            """SELECT kind, severity, message FROM alerts
               WHERE ts >= ? ORDER BY ts DESC LIMIT 5""",
            (time.time() - 86400,),
        ).fetchall()

        conn.close()

        lines = ["=== SLIPSTREAM SESSION WARM-UP ==="]
        lines.append(f"Project: {_shorten_path(cwd)}  Session: {session_id[:16]}")

        if hot_files:
            lines.append(f"\nHot files (re-read most often — already in context):")
            for f in hot_files:
                lines.append(f"  {_shorten_path(f)}")

        if pending:
            lines.append(f"\nPending queue ({len(pending)} job(s)):")
            for j in pending:
                prompt = (j["prompt"] or "")[:70]
                lines.append(f"  #{j['id']} [{j['status']}] {prompt}")

        if analysis["potential_saving_pct"] >= 15:
            lines.append(
                f"\n⚡ Token coach: {analysis['potential_saving_pct']:.0f}% savings available — run `slipstream coach` to see how."
            )

        if recent_alerts:
            sym = {"spike": "⚡", "drift": "🧭", "loop": "🔁", "stale": "📂", "scope_creep": "🔭"}
            lines.append(f"\nRecent alerts (last 24h):")
            for a in recent_alerts:
                icon = sym.get(a["kind"], "•")
                lines.append(f"  {icon} [{a['kind']}] {a['message'][:80]}")
            lines.append("  Run `slipstream alerts` for full list.")

        lines.append("=== END WARM-UP ===")
        print("\n".join(lines))

    except Exception:
        pass
    return 0


