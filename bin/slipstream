def _extract_first_user_intent(transcript_path: str) -> str:
    p = Path(transcript_path)
    if not p.exists():
        return ""
    try:
        with open(p) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                role = obj.get("role") or obj.get("type", "")
                if role != "user":
                    continue
                content = obj.get("content") or ""
                if isinstance(content, list):
                    parts = [c.get("text", "") for c in content if isinstance(c, dict)]
                    content = " ".join(parts)
                content = str(content).strip()
                if len(content) >= 20:
                    return content[:500]
    except Exception:
        pass
    return ""


def _score_prompt(intent: str) -> dict:
    if not intent:
        return {"score": 0, "suggestions": []}
    suggestions = []
    score = 100

    has_file = bool(re.search(r'[\w/]+\.\w{1,6}', intent))
    if not has_file and len(intent) > 30:
        suggestions.append("Pin specific files (e.g. src/auth/session.py) to narrow scope")
        score -= 20

    has_criteria = bool(re.search(
        r'(?i)(should|must|expect|test|verify|confirm|until|when done|acceptance|criteria)', intent
    ))
    if not has_criteria:
        suggestions.append("Add acceptance criteria — what does 'done' look like?")
        score -= 25

    vague = re.findall(r'(?i)\b(the thing|it|the issue|that|this|the problem|the bug)\b', intent)
    if len(vague) >= 2:
        suggestions.append(f"Replace vague references ({', '.join(set(vague[:3]))}) with specifics")
        score -= 20

    has_scope = bool(re.search(
        r'(?i)(only|just|limit|don\'t touch|keep|leave|focus on|specifically)', intent
    ))
    if not has_scope and len(intent) < 100:
        suggestions.append("Define scope — what should NOT be changed?")
        score -= 15

    return {"score": max(score, 0), "suggestions": suggestions[:3]}


def _detect_spike(conn: sqlite3.Connection, session_id: str, usage: dict,
                  now: float, config: dict) -> str:
    this_turn = (usage.get("input_tokens", 0) + usage.get("output_tokens", 0) +
                 usage.get("cache_read_tokens", 0) + usage.get("cache_write_tokens", 0))
    if this_turn < 5000:
        return ""

    rows = conn.execute(
        """SELECT AVG(input_tokens+output_tokens+cache_read_tokens+cache_write_tokens) as avg,
                  COUNT(*) as n
           FROM turns WHERE session_id=? AND ts < ?""",
        (session_id, now),
    ).fetchone()
    avg = rows["avg"] or 0
    n = rows["n"] or 0
    if n < 3 or avg < 1000:
        return ""

    ratio = this_turn / avg
    if ratio >= 3.0:
        return f"Turn used {this_turn:,} tokens ({ratio:.1f}× session avg of {avg:,.0f})"
    return ""


def _detect_loop(conn: sqlite3.Connection, session_id: str) -> str:
    rows = conn.execute(
        """SELECT tool_name, file_paths FROM tool_uses
           WHERE session_id=? ORDER BY ts DESC LIMIT 15""",
        (session_id,),
    ).fetchall()
    if len(rows) < 6:
        return ""

    sigs = []
    for r in rows:
        sigs.append(f"{r['tool_name']}:{r['file_paths'] or ''}")

    for i in range(len(sigs) - 2):
        if sigs[i] == sigs[i+1] == sigs[i+2]:
            tool = rows[i]["tool_name"]
            fp = rows[i]["file_paths"]
            label = _shorten_path((json.loads(fp) or ["?"])[0] if fp else "?")
            return f"{tool} on {label} repeated 3+ times — possible stuck loop"
    return ""


def _detect_drift(conn: sqlite3.Connection, session_id: str, now: float) -> str:
    intent_row = conn.execute(
        "SELECT intent FROM session_intents WHERE session_id=?", (session_id,)
    ).fetchone()
    if not intent_row:
        return ""

    intent = intent_row["intent"].lower()
    intent_files = set(re.findall(r'[\w/-]+\.\w{2,6}', intent))
    intent_dirs = set(re.findall(r'[\w/-]+/', intent))
    intent_words = set(w for w in re.findall(r'\b\w{4,}\b', intent)
                       if w not in ("will", "that", "this", "with", "from", "have", "been"))

    if not intent_files and not intent_dirs and len(intent_words) < 3:
        return ""

    rows = conn.execute(
        """SELECT file_paths FROM tool_uses
           WHERE session_id=? AND tool_name IN ('Write','Edit','MultiEdit')
             AND ts > ? ORDER BY ts DESC LIMIT 20""",
        (session_id, now - 1800),
    ).fetchall()
    if len(rows) < 5:
        return ""

    unrelated = 0
    total = 0
    for r in rows:
        if not r["file_paths"]:
            continue
        try:
            fps = json.loads(r["file_paths"])
        except Exception:
            fps = [r["file_paths"]]
        for fp in fps:
            total += 1
            fp_lower = fp.lower()
            related = (
                any(f in fp_lower for f in intent_files) or
                any(d in fp_lower for d in intent_dirs) or
                any(w in fp_lower for w in intent_words)
            )
            if not related:
                unrelated += 1

    if total >= 5 and unrelated / total >= 0.6:
        return (f"{unrelated}/{total} recent edits touch files not mentioned in original intent — "
                "consider `slipstream handoff` if scope changed")
    return ""


def _check_stale_read(conn: sqlite3.Connection, session_id: str, fp: str, now: float) -> str:
    prev = conn.execute(
        """SELECT MAX(ts) as last_ts FROM tool_uses
           WHERE session_id=? AND file_paths LIKE ? AND tool_name='Read'""",
        (session_id, f'%{fp}%'),
    ).fetchone()
    if not prev or not prev["last_ts"]:
        return ""
    last_ts = prev["last_ts"]

    try:
        mtime = Path(fp).stat().st_mtime
    except Exception:
        return ""

    if mtime > last_ts + 2:
        age = int((now - last_ts) / 60)
        return (f"{_shorten_path(fp)} was read {age}m ago but changed on disk since — "
                "re-read recommended")
    return ""


def _check_scope_creep(conn: sqlite3.Connection, session_id: str, fp: str) -> str:
    intent_row = conn.execute(
        "SELECT intent FROM session_intents WHERE session_id=?", (session_id,)
    ).fetchone()
    if not intent_row:
        return ""

    intent = intent_row["intent"].lower()
    intent_files = set(re.findall(r'[\w/-]+\.\w{2,6}', intent))
    intent_dirs = set(re.findall(r'[\w/-]+/', intent))
    intent_words = set(w for w in re.findall(r'\b\w{4,}\b', intent)
                       if w not in ("will", "that", "this", "with", "from", "have", "been"))

    if not intent_files and not intent_dirs and len(intent_words) < 3:
        return ""

    fp_lower = fp.lower()
    related = (
        any(f in fp_lower for f in intent_files) or
        any(d in fp_lower for d in intent_dirs) or
        any(w in fp_lower for w in intent_words)
    )

    if not related:
        edit_count = conn.execute(
            "SELECT COUNT(*) FROM decision_log WHERE session_id=?", (session_id,)
        ).fetchone()[0]
        if edit_count >= 3:
            return (f"{_shorten_path(fp)} not in original scope — "
                    "run `slipstream drift` if this is intentional")
    return ""


