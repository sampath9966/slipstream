def cmd_handoff(args) -> int:
    try:
        conn = open_db(db_path())
    except Exception as e:
        print(f"slipstream: cannot open DB: {e}", file=sys.stderr)
        return 1

    session_id = getattr(args, "session_id", None)
    if not session_id:
        row = conn.execute(
            "SELECT session_id FROM turns ORDER BY ts DESC LIMIT 1"
        ).fetchone()
        if row:
            session_id = row["session_id"]

    if not session_id:
        print("[slipstream handoff] No sessions found.")
        conn.close()
        return 0

    intent_row = conn.execute(
        "SELECT intent, cwd, ts FROM session_intents WHERE session_id=?", (session_id,)
    ).fetchone()

    turns = conn.execute(
        "SELECT COUNT(*) as n, SUM(input_tokens+output_tokens) as tok, MIN(ts) as start, MAX(ts) as end FROM turns WHERE session_id=?",
        (session_id,),
    ).fetchone()

    decisions = conn.execute(
        "SELECT tool_name, file_path, description, ts FROM decision_log WHERE session_id=? ORDER BY ts",
        (session_id,),
    ).fetchall()

    snap = conn.execute(
        "SELECT decisions, files_read FROM snapshots WHERE session_id=? ORDER BY ts DESC LIMIT 1",
        (session_id,),
    ).fetchone()

    alerts_rows = conn.execute(
        "SELECT kind, message FROM alerts WHERE session_id=? ORDER BY ts",
        (session_id,),
    ).fetchall()

    pending = conn.execute(
        "SELECT id, prompt, status FROM jobs WHERE status IN ('pending_review','approved') ORDER BY created_at LIMIT 10"
    ).fetchall()

    conn.close()

    started = ""
    if turns and turns["start"]:
        started = datetime.fromtimestamp(turns["start"], tz=timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    lines = [
        f"# Session Handoff",
        f"",
        f"**Session**: `{session_id[:24]}`  ",
        f"**Started**: {started}  ",
        f"**Project**: {_shorten_path((intent_row['cwd'] if intent_row else '') or os.getcwd())}  ",
        f"**Turns**: {turns['n'] or 0}  **Tokens**: {turns['tok'] or 0:,}",
        f"",
        f"## Original Intent",
        f"",
        intent_row["intent"] if intent_row else "_Not captured_",
        f"",
        f"## Files Changed",
        f"",
    ]

    if decisions:
        seen = {}
        for d in decisions:
            fp = d["file_path"] or ""
            if fp not in seen:
                seen[fp] = d["tool_name"]
        for fp, tool in seen.items():
            lines.append(f"- `{fp}` ({tool})")
    else:
        lines.append("_No edits recorded_")

    lines += [
        f"",
        f"## Key Decisions",
        f"",
    ]
    if snap and snap["decisions"]:
        for d in snap["decisions"].split("\n")[:10]:
            if d.strip():
                lines.append(f"- {d.strip()}")
    else:
        lines.append("_No anchor snapshot found_")

    if alerts_rows:
        lines += ["", "## Alerts Fired", ""]
        for a in alerts_rows:
            lines.append(f"- **{a['kind']}**: {a['message']}")

    if pending:
        lines += ["", "## Pending Queue", ""]
        for j in pending:
            lines.append(f"- #{j['id']} `[{j['status']}]` {(j['prompt'] or '')[:80]}")

    lines += ["", "## Next Steps", "", "_Fill in before handing off._", ""]

    doc = "\n".join(lines)

    output = getattr(args, "output", None)
    if output:
        Path(output).write_text(doc)
        print(f"[slipstream handoff] Written to {output}")
    else:
        print(doc)
    return 0


def cmd_why(args) -> int:
    target = getattr(args, "file", None)
    session_id = getattr(args, "session_id", None)
    try:
        conn = open_db(db_path())
    except Exception as e:
        print(f"slipstream: cannot open DB: {e}", file=sys.stderr)
        return 1

    q = "SELECT * FROM decision_log WHERE 1=1"
    params: list = []
    if target:
        q += " AND file_path LIKE ?"
        params.append(f"%{target}%")
    if session_id:
        q += " AND session_id=?"
        params.append(session_id)
    q += " ORDER BY ts DESC LIMIT 30"

    rows = conn.execute(q, params).fetchall()
    conn.close()

    if not rows:
        print(f"[slipstream why] No decisions found{' for ' + target if target else ''}.")
        return 0

    print(f"\n  Decision log{' for ' + target if target else ''}\n")
    for r in rows:
        ts = datetime.fromtimestamp(r["ts"], tz=timezone.utc).strftime("%m-%d %H:%M")
        print(f"  {ts}  {r['tool_name']:<10}  {_shorten_path(r['file_path'] or '')}")
        if r["prompt_ctx"]:
            ctx = r["prompt_ctx"][:120].replace("\n", " ")
            print(f"           ctx: {ctx}")
        print()
    return 0


def cmd_alerts(args) -> int:
    try:
        conn = open_db(db_path())
    except Exception as e:
        print(f"slipstream: cannot open DB: {e}", file=sys.stderr)
        return 1

    days = getattr(args, "days", 7)
    kind_filter = getattr(args, "kind", None)
    since = time.time() - days * 86400

    q = "SELECT * FROM alerts WHERE ts>=?"
    params: list = [since]
    if kind_filter:
        q += " AND kind=?"
        params.append(kind_filter)
    q += " ORDER BY ts DESC LIMIT 50"

    rows = conn.execute(q, params).fetchall()
    conn.close()

    if not rows:
        print(f"[slipstream alerts] No alerts in last {days}d.")
        return 0

    sym = {"spike": "⚡", "drift": "🧭", "loop": "🔁", "stale": "📂", "scope_creep": "🔭"}
    bar = "─" * 62
    print(f"\n{'Slipstream Alerts':^62}")
    print(f"{'last ' + str(days) + ' days':^62}")
    print(bar)
    for r in rows:
        ts = datetime.fromtimestamp(r["ts"], tz=timezone.utc).strftime("%m-%d %H:%M")
        icon = sym.get(r["kind"], "•")
        print(f"  {ts}  {icon} [{r['kind']:<12}]  {r['message'][:60]}")
    print(bar)
    print()
    return 0


def cmd_drift(args) -> int:
    session_id = getattr(args, "session_id", None)
    try:
        conn = open_db(db_path())
    except Exception as e:
        print(f"slipstream: cannot open DB: {e}", file=sys.stderr)
        return 1

    if not session_id:
        row = conn.execute(
            "SELECT session_id FROM session_intents ORDER BY ts DESC LIMIT 1"
        ).fetchone()
        if row:
            session_id = row["session_id"]

    if not session_id:
        print("[slipstream drift] No sessions with recorded intent found.")
        conn.close()
        return 0

    intent_row = conn.execute(
        "SELECT intent, cwd, ts FROM session_intents WHERE session_id=?", (session_id,)
    ).fetchone()

    edits = conn.execute(
        """SELECT file_path, MIN(ts) as first_ts FROM decision_log
           WHERE session_id=? GROUP BY file_path ORDER BY first_ts""",
        (session_id,),
    ).fetchall()

    alerts_rows = conn.execute(
        "SELECT ts, kind, message FROM alerts WHERE session_id=? AND kind IN ('drift','scope_creep') ORDER BY ts",
        (session_id,),
    ).fetchall()

    conn.close()

    print(f"\n  Drift analysis — session {session_id[:20]}...\n")
    if intent_row:
        print(f"  Intent: {intent_row['intent'][:120]}")
    print()

    if edits:
        print(f"  Files edited ({len(edits)}):")
        for e in edits:
            ts = datetime.fromtimestamp(e["first_ts"], tz=timezone.utc).strftime("%H:%M")
            print(f"    {ts}  {_shorten_path(e['file_path'] or '')}")
    else:
        print("  No edits recorded.")

    if alerts_rows:
        print(f"\n  Drift / scope alerts:")
        for a in alerts_rows:
            ts = datetime.fromtimestamp(a["ts"], tz=timezone.utc).strftime("%H:%M")
            print(f"    {ts}  {a['message'][:80]}")
    print()
    return 0


# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

def cmd_doctor(args) -> int:
    ok = True
    print("slipstream doctor\n")

    path = db_path()
    print(f"  DB path: {path}")
    try:
        conn = open_db(path)
        turns = conn.execute("SELECT COUNT(*) FROM turns").fetchone()[0]
        tools = conn.execute("SELECT COUNT(*) FROM tool_uses").fetchone()[0]
        jobs = conn.execute("SELECT COUNT(*) FROM jobs").fetchone()[0]
        snaps = conn.execute("SELECT COUNT(*) FROM snapshots").fetchone()[0]
        decs = conn.execute("SELECT COUNT(*) FROM decision_log").fetchone()[0]
        alts = conn.execute("SELECT COUNT(*) FROM alerts").fetchone()[0]
        conn.close()
        print(f"  DB: OK  ({turns} turns, {tools} tool uses, {jobs} jobs, {snaps} snapshots, {decs} decisions, {alts} alerts)")
    except Exception as e:
        print(f"  DB: ERROR — {e}")
        ok = False

    config = get_config()
    print(f"  Config: window={config['window_tokens']:,} tokens, "
          f"warn={config['warn_threshold_pct']}%, "
          f"critical={config['critical_threshold_pct']}%, "
          f"pacing threshold={config['pacing_threshold_pct']}%")

    plugin_root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    print(f"  CLAUDE_PLUGIN_ROOT: {plugin_root or '(not set — run inside Claude Code)'}")

    this = Path(__file__).resolve()
    print(f"  Engine: {this}")
    if not os.access(this, os.X_OK):
        print("  Engine: NOT executable — run: chmod +x bin/slipstream")
        ok = False

    system = platform.system()
    if system == "Darwin":
        r = subprocess.run(["launchctl", "list", "com.slipstream.dispatch"],
                           capture_output=True, text=True)
        svc = "running" if r.returncode == 0 else "not installed"
    elif system == "Linux":
        r = subprocess.run(["systemctl", "--user", "is-active", "slipstream-dispatch"],
                           capture_output=True, text=True)
        svc = r.stdout.strip() or "not installed"
    else:
        svc = "N/A"
    print(f"  Dispatcher service: {svc}")

    claude_bin = shutil.which("claude")
    print(f"  claude CLI: {claude_bin or 'NOT FOUND (needed for dispatch)'}")

    print()
    print("  Status:", "✔ healthy" if ok else "✘ issues found (see above)")
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# Utilities
# ---------------------------------------------------------------------------

def _shorten_path(p: str) -> str:
    if not p:
        return ""
    home = str(Path.home())
    if p.startswith(home):
        p = "~" + p[len(home):]
    if len(p) > 48:
        p = "…" + p[-47:]
    return p


# ---------------------------------------------------------------------------
# CLI entrypoint
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(prog="slipstream",
                                     description="Session economics engine for Claude Code.")
    sub = parser.add_subparsers(dest="command")

    # Module 1
    sub.add_parser("record")
    sub.add_parser("record-tool")
    p_rep = sub.add_parser("report")
    p_rep.add_argument("--json", action="store_true")
    p_rep.add_argument("--days", type=int, default=7)
    p_rep.add_argument("--session")
    sub.add_parser("statusline")
    p_mon = sub.add_parser("monitor")
    p_mon.add_argument("--session-id", dest="session_id")

    # Module 2
    p_add = sub.add_parser("add")
    p_add.add_argument("prompt")
    p_add.add_argument("--cwd")
    p_add.add_argument("--files", nargs="*")
    p_add.add_argument("--after", type=int)
    p_add.add_argument("--priority", type=int, default=0)

    sub.add_parser("approve")
    sub.add_parser("dispatch")

    p_queue = sub.add_parser("queue")
    p_queue.add_argument("--status")
    p_queue.add_argument("--json", action="store_true")

    p_svc = sub.add_parser("service")
    p_svc.add_argument("action", choices=["install", "uninstall", "status"])

    # Module 3
    sub.add_parser("anchor-snapshot")
    sub.add_parser("anchor-inject")
    p_anc = sub.add_parser("anchor")
    p_anc.add_argument("--session-id", dest="session_id")

    # Module 4
    sub.add_parser("guard-check")
    p_guard = sub.add_parser("guard")
    p_guard_sub = p_guard.add_subparsers(dest="guard_action")
    p_gi = p_guard_sub.add_parser("init")
    p_gi.add_argument("--project-dir", dest="project_dir", default=None)
    p_gi.add_argument("--force", action="store_true")

    # Module 5
    p_coach = sub.add_parser("coach")
    p_coach.add_argument("--days", type=int, default=7)
    p_coach.add_argument("--json", action="store_true")

    p_opt = sub.add_parser("optimize")
    p_opt.add_argument("--days", type=int, default=7)
    p_opt.add_argument("--top", type=int, default=10)
    p_opt.add_argument("--project-dir", dest="project_dir", default=None)
    p_opt.add_argument("--output", default=None)
    p_opt.add_argument("--dry-run", dest="dry_run", action="store_true")

    sub.add_parser("decide")
    sub.add_parser("warmup")

    # Module 6
    p_handoff = sub.add_parser("handoff")
    p_handoff.add_argument("--session-id", dest="session_id")
    p_handoff.add_argument("--output", default=None)

    p_why = sub.add_parser("why")
    p_why.add_argument("file", nargs="?", default=None)
    p_why.add_argument("--session-id", dest="session_id")

    p_alts = sub.add_parser("alerts")
    p_alts.add_argument("--days", type=int, default=7)
    p_alts.add_argument("--kind", default=None,
                        choices=["spike", "drift", "loop", "stale", "scope_creep"])

    p_drift = sub.add_parser("drift")
    p_drift.add_argument("--session-id", dest="session_id")

    sub.add_parser("doctor")

    args = parser.parse_args()

    dispatch = {
        "record": cmd_record,
        "record-tool": cmd_record_tool,
        "report": cmd_report,
        "statusline": cmd_statusline,
        "monitor": cmd_monitor,
        "add": cmd_add,
        "approve": cmd_approve,
        "queue": cmd_queue_list,
        "dispatch": cmd_dispatch,
        "service": cmd_service,
        "anchor-snapshot": cmd_anchor_snapshot,
        "anchor-inject": cmd_anchor_inject,
        "anchor": cmd_anchor,
        "guard-check": cmd_guard_check,
        "guard": lambda a: cmd_guard_init(a) if getattr(a, "guard_action", None) == "init" else (print("Usage: slipstream guard init") or 1),
        "coach": cmd_coach,
        "optimize": cmd_optimize,
        "decide": cmd_decide,
        "warmup": cmd_warmup,
        "handoff": cmd_handoff,
        "why": cmd_why,
        "alerts": cmd_alerts,
        "drift": cmd_drift,
        "doctor": cmd_doctor,
    }

    handler = dispatch.get(args.command)
    if handler is None:
        parser.print_help()
        return 1

    try:
        return handler(args) or 0
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
