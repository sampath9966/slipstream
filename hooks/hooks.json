{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/slipstream.py\" record",
            "timeout": 10,
            "statusMessage": "slipstream: recording turn"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/slipstream.py\" record-tool",
            "timeout": 5,
            "statusMessage": "slipstream: recording tool use"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/slipstream.py\" anchor-snapshot",
            "timeout": 15,
            "statusMessage": "slipstream: snapshotting anchor before compaction"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/slipstream.py\" anchor-inject",
            "timeout": 15,
            "statusMessage": "slipstream: re-injecting anchor after compaction"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/slipstream.py\" warmup",
            "timeout": 10,
            "statusMessage": "slipstream: session warm-up"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/slipstream.py\" guard-check",
            "timeout": 5,
            "statusMessage": "slipstream: checking rule guard"
          }
        ]
      }
    ]
  }
}
